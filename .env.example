# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored — never commit real secrets.
# Every variable here is validated at boot: apps/api/src/lib/env.ts for the API,
# apps/worker/src/env.ts for the worker. A missing or malformed value stops the
# process with a message naming the variable.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Datastores (match docker-compose.yml) ---
MONGO_URI=mongodb://localhost:27017/api-usage-dashboard
REDIS_URL=redis://localhost:6379

# --- Session auth (the dashboard) ---
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Dashboard origin, for CORS + cookie scope ---
# Note: /v1 ingest uses its own permissive CORS. Server-to-server clients have
# no Origin header at all, so pinning them here would reject every one of them.
WEB_ORIGIN=http://localhost:5173

# --- Ingest rate limit (per API key, sliding window) ---
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# --- Metrics cache ---
# Seconds a computed metrics response stays in Redis. The worker also
# invalidates explicitly when rollups change, so this is only the backstop.
METRICS_CACHE_TTL=60

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

WORKER_CONCURRENCY=4

# How far back each scheduled run recomputes. Not just the current bucket:
# events arrive late, so a window that looked complete can still gain rows.
ROLLUP_HOUR_LOOKBACK_HOURS=3
ROLLUP_DAY_LOOKBACK_DAYS=2
